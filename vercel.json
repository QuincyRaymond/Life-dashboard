{
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/strava-sync", "schedule": "0 2 * * *" },
    { "path": "/api/strava-sync", "schedule": "0 3 * * *" }
  ]
}
